# Copy this file to .env.local and fill in the values.
# All NEXT_PUBLIC_ vars are inlined at build time and shipped to the browser.

NEXT_PUBLIC_EMAIL_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAIL_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAIL_PUBLIC_KEY=your_emailjs_public_key
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SUPABASE_URL=https://.........supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Absolute base used for links inside emails (falls back to the prod domain).
NEXT_PUBLIC_SITE_URL=https://gene-paul-mar-javier.dev

# ── Server-side email (testimonial notifications) ────────────────────────────
# The contact form sends from the browser with the public key above. Server
# actions can't use that endpoint, so they authenticate with the PRIVATE key.
# No NEXT_PUBLIC_ prefix — this must never reach the browser.
#
# Requires "API calls from non-browser applications" to be ENABLED in
# EmailJS → Account → Security, otherwise every server send returns 403.
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# One additional EmailJS template, separate from the contact-form one above.
# Sent to you when someone submits a testimonial. Variables:
#   to_email, to_name, from_name, from_email, role, company,
#   relationship, rating, message, review_url
#
# There is no "testimonial published" notification: the free tier allows only
# two templates and both are in use (contact form + this one). The author's
# address is still captured and shown in the admin so you can reply by hand.
EMAILJS_TEMPLATE_TESTIMONIAL_SUBMITTED=template_xxxxxxx
